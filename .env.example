# Скопируйте этот файл в .env и вставьте свои значения.
# ВАЖНО: файл .env содержит секреты и НЕ должен попадать в git.

# Провайдер LLM: gigachat или yandex
LLM_PROVIDER=gigachat

# --- GigaChat (developers.sber.ru) ---
# Вариант 1: готовый "ключ авторизации" (Authorization key) из личного кабинета.
# Это строка вида Base64(client_id:client_secret).
GIGACHAT_AUTH_KEY=
# Вариант 2: Client ID и Client Secret — ключ авторизации соберётся автоматически.
# Заполняйте ЛИБО вариант 1, ЛИБО вариант 2.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Область доступа: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B, GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max,
#         GigaChat-3-Lightning, GigaChat-3-Pro, GigaChat-3-Ultra
GIGACHAT_MODEL=GigaChat-2

# --- Поиск ---
# Мультизапрос: из одного вопроса пользователя делать несколько поисковых
# формулировок (норма закона, судебная практика, порядок действий).
# Выключается значением False.
MULTI_QUERY=True

# Поисковые движки ddgs через запятую: duckduckgo, brave, google, mojeek,
# startpage, yahoo, wikipedia. По умолчанию оставлен только рабочий и быстрый.
SEARCH_BACKENDS=duckduckgo

# --- YandexGPT (задел на будущее) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
